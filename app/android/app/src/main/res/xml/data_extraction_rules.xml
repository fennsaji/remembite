<?xml version="1.0" encoding="utf-8"?>
<!--
  Opt out of cloud backup and device-to-device transfer entirely.
  flutter_secure_storage is encrypted with a hardware Keystore key that does
  not travel with a backup, so a restored auth_user blob is undecryptable, and
  the Drift DB is per-account state that must be re-fetched on sign-in anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
